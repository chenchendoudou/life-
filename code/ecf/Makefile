# =============================================================================
#  ECF（异常控制流）示例集 —— Makefile
# =============================================================================
#  本 Makefile 编译 code/ecf/ 根目录下所有 C 源文件。
#  头文件来自 ../include/csapp.h，wrapper 实现来自 ../src/csapp.c。
#
#  用法：
#    make                  编译所有示例（生成 30 个可执行文件到 bin/）
#    make clean            删除 bin/ 下的所有可执行文件
#    make <某个文件名>     单独编译某一个示例，例如：
#      make bin/fork
#      make bin/shellex
#    make -n               干跑，只打印命令而不实际执行
#    make -B               强制重新编译，忽略时间戳
#
#  关于 rfork.c：
#    rfork.c 只定义了 pid_t Fork(void)，本身没有 main，
#    它的作用是把 fork 改成"父子顺序随机"的版本，便于观察非确定性。
#    通常用法是和 fork.c 一起编译（取代 csapp.c 里的 Fork）：
#      gcc -o bin/fork_rfork fork.c rfork.c
#    `make bin/fork_rfork` 即可生成。
# =============================================================================

# -----------------------------------------------------------------------------
# 工具与编译选项
# -----------------------------------------------------------------------------
CC       = gcc

# 学习阶段保留 -O0 -g，方便用 gdb 跟踪 fork/signal/信号处理过程。
CFLAGS   = -Wall -O0 -g

# 头文件搜索路径：../include，让所有 .c 都能找到 csapp.h。
INCLUDES = -I../include

# csapp.c 包装了 fork/execve/signal/wait 等系统调用，
# 绝大多数示例都要链接它。
CSAPP_C  = ../src/csapp.c

# -----------------------------------------------------------------------------
# 源文件清单
# -----------------------------------------------------------------------------
# 列出所有 .c 源文件（hello-asm.sa 是汇编文本，rfork.c 是特例，下面单独处理）。
# 用 wildcard 自动收集，新增 .c 文件不用再改这里。
SRCS = $(wildcard *.c)

# 排除 rfork.c：它没有 main，且自己的 Fork() 与 csapp.c 的 Fork() 冲突。
# rfork 走下面的独立目标 bin/fork_rfork。
SRCS_NO_RFORK = $(filter-out rfork.c, $(SRCS))

# 源文件对应的可执行文件名（去后缀），全部放在 bin/ 下。
BINS = $(patsubst %.c,bin/%,$(SRCS_NO_RFORK))

# 额外提供一个"非确定性 fork"版本（fork.c + rfork.c，不链 csapp.c）。
BINS_EXTRA = bin/fork_rfork

# -----------------------------------------------------------------------------
# 默认目标
# -----------------------------------------------------------------------------
all: $(BINS) $(BINS_EXTRA)

# -----------------------------------------------------------------------------
# bin/ 目录（order-only prerequisite）
# -----------------------------------------------------------------------------
# 把所有产物集中到 bin/，避免源码目录里冒出一堆可执行文件。
bin:
	@mkdir -p bin

# -----------------------------------------------------------------------------
# 静态模式规则：默认情况下，bin/X 由 X.c 编译并链接 ../src/csapp.c 得到
# -----------------------------------------------------------------------------
# 只对 $(BINS) 列表里的目标生效，不会误伤 bin/fork_rfork。
# 依赖里加 | bin 表示 bin/ 目录是"order-only"，
# 即便 bin/ 比源码还新也不会触发重新链接。
$(BINS): bin/%: %.c | bin
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ $< $(CSAPP_C)

# -----------------------------------------------------------------------------
# 特殊规则：bin/fork_rfork 用 rfork.c 替代 csapp.c 提供 Fork() 实现
# -----------------------------------------------------------------------------
bin/fork_rfork: fork.c rfork.c | bin
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ $^

# -----------------------------------------------------------------------------
# 清理
# -----------------------------------------------------------------------------
clean:
	rm -rf bin

# -----------------------------------------------------------------------------
# .PHONY：声明伪目标
# -----------------------------------------------------------------------------
.PHONY: all clean
# =============================================================================
# 备注
# =============================================================================
# * hello-asm.sa  是汇编源码（AT&T 语法），本 Makefile 不处理它。
#   如果想汇编/运行，可以：
#     gcc -o bin/hello-asm hello-asm.sa && ./bin/hello-asm
# * bin/fork 与 bin/fork_rfork 的区别：
#     bin/fork        用 csapp.c 的 Fork()，父子谁先跑由调度器决定
#     bin/fork_rfork  用 rfork.c 的 Fork()，强制随机一方先 sleep 再跑
#   多次执行后者，能更稳定地观察到非确定性输出。
# * 如果某个新示例不需要 csapp.c（比如只用 libc），
#   可以照搬 bin/fork_rfork 那条规则自己写一条精确规则，
#   精确规则的优先级高于上面的静态模式规则。
# =============================================================================
